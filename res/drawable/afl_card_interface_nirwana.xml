<?xml version="1.0" encoding="utf-8"?>
<ripple
    android:color="@android:color/system_accent1_50"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@android:id/mask">
        <shape>
            <solid
                android:color="#ffffffff" />
            <corners
                android:topLeftRadius="26.0dip"
                android:topRightRadius="26.0dip"
                android:bottomLeftRadius="26.0dip"
                android:bottomRightRadius="26.0dip" />
        </shape>
    </item>
    <item
        android:id="@android:id/background">
        <shape
            android:shape="rectangle">
            <solid
                android:color="@color/afl_card_color" />
            <corners
                android:topLeftRadius="26.0dip"
                android:topRightRadius="26.0dip"
                android:bottomLeftRadius="26.0dip"
                android:bottomRightRadius="26.0dip" />
        </shape>
    </item>
</ripple>