<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="start"
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="1.0dip"
    android:baselineAligned="false"
    android:paddingStart="13.0dip"
    android:paddingEnd="13.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/themes_card"
            android:clickable="true"
            android:layout_width="fill_parent"
            android:layout_height="350.0dip"
            android:layout_marginTop="20.0dip"
            android:layout_marginBottom="16.0dip"
            android:layout_weight="1.0"
            android:layout_marginHorizontal="16.0dip">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/afl_lockscreen_feature_card"
                android:background="@android:color/transparent"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="0.5"
                android:layout_marginEnd="8.0dip"
                app:cardCornerRadius="26.0dip"
                app:cardElevation="5.0dip"
                app:rippleColor="@android:color/system_accent1_300"
                app:strokeColor="?android:textColorPrimary"
                app:strokeWidth="2.0dip">
                <com.android.settings.ui.AnimateWallpaperView
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:scaleType="centerCrop"
                    android:elevation="0.0dip" />
                <RelativeLayout
                    android:gravity="center"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">
                    <ImageView
                        android:layout_width="18.0dip"
                        android:layout_height="18.0dip"
                        android:layout_marginBottom="24.0dip"
                        android:src="@drawable/ic_lock_outline"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:tint="#ffffffff"
                        android:layout_above="@+id/afl_lockscreen_feature_clock_preview"
                        android:layout_centerHorizontal="true"
                        android:layout_marginStart="16.0dip" />
                    <TextClock
                        android:textSize="34.0sp"
                        android:textColor="#ffffffff"
                        android:id="@+id/afl_lockscreen_feature_clock_preview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="48.0dip"
                        android:layout_above="@+id/afl_lockscreen_clock_preview"
                        android:layout_centerHorizontal="true"
                        android:format12Hour="hh:mm"
                        android:format24Hour="HH:mm"
                        android:textFontWeight="300"
                        style="@style/afl_text_primary" />
                    <TextClock
                        android:textSize="14.0sp"
                        android:textColor="#ffffffff"
                        android:id="@+id/afl_lockscreen_clock_preview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="48.0dip"
                        android:layout_centerHorizontal="true"
                        android:format12Hour="EEE, MMM dd"
                        android:format24Hour="EEE, MMM dd"
                        android:textFontWeight="300"
                        style="@style/afl_text_primary" />
                    <TextView
                        android:textSize="17.0sp"
                        android:textColor="#ffffffff"
                        android:id="@+id/afl_lockscreen_feature_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24.0dip"
                        android:text="Themes"
                        android:layout_below="@+id/afl_lockscreen_clock_preview"
                        android:layout_centerHorizontal="true"
                        android:textFontWeight="300"
                        style="@style/afl_text_primary" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
                <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0.0dip"
                        android:layout_height="fill_parent"
                        android:layout_weight="0.5"
                        android:layout_marginStart="8.0dip">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:id="@+id/clock_face"
                            android:background="@drawable/afl_card_interface_nirwana"
                            android:layout_width="fill_parent"
                            android:layout_height="150.0dip"
                            android:layout_marginBottom="8.0dip"
                            android:layout_weight="1.0"
                            android:paddingStart="16.0dip"
                            android:paddingEnd="16.0dip">
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/clock_face_icon"
                                android:gravity="center"
                                android:layout_width="90dp"
                                android:layout_height="70dp"
                                android:background="@*android:color/transparent"
                                android:clickable="false"
                                android:clipToOutline="true"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">
                                <com.android.settings.ui.WallpaperView
                                    android:gravity="center"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:contentDescription="@null"
                                    android:foreground="@drawable/wallpaper_scrim"
                                    android:background="@drawable/wallpaper_scrim"
                                    android:elevation="0dp" />
                                <RelativeLayout
                                    android:id="@+id/clock_face_clock_frame"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center">
                                    <TextClock
                                        android:id="@+id/clock_face_clock_preview"
                                        android:textSize="25sp"
                                        android:textColor="@*android:color/system_accent1_100"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:format12Hour="hh:mm"
                                        android:format24Hour="hh:mm"
                                        android:fontFamily="@*android:string/config_clockFontFamily"
                                        android:textFontWeight="300"
                                        android:textAlignment="center"
                                        android:layout_centerInParent="true"
                                        style="@style/mtx_text_style_h6" />
                                </RelativeLayout>
                            </com.google.android.material.card.MaterialCardView>
                            <TextView
                                android:textSize="17.0sp"
                                android:textColor="?android:textColorPrimary"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:layout_width="fill_parent"
                                android:layout_height="49.0dip"
                                android:text="Lockscreen"
                                android:maxLines="2"
                                style="@style/afl_text_primary" />
                        </LinearLayout>
                <LinearLayout
                    android:gravity="start|center"
                    android:orientation="vertical"
                    android:id="@+id/system_themes"
                    android:background="@drawable/afl_card_interface_nirwana"
                    android:padding="16.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="200.0dip"
                    android:layout_marginTop="8.0dip"
                    android:layout_weight="1.0">
                    <TextView
                        android:textSize="18.0sp"
                        android:textColor="?android:textColorPrimary"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="System"
                        android:maxLines="2"
                        style="@style/afl_text_primary" />
                    <TextView
                        android:textSize="13.0sp"
                        android:textColor="?android:textColorPrimary"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/addon_summary"
                        android:maxLines="3"
                        android:layout_marginVertical="16.0dip"
                        style="@style/afl_text_primary" />
                    <TextView
                        android:textSize="15.0sp"
                        android:textColor="?android:textColorPrimary"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:background="@drawable/afl_card_interface_nirwana"
                        android:padding="4.0dip"
                        android:layout_width="80.0dip"
                        android:layout_height="30.0dip"
                        android:text="Here!"
                        android:backgroundTint="@android:color/system_accent1_300"
                        style="@style/afl_text_primary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="150.0dip"
            android:layout_marginBottom="16.0dip"
            android:layout_marginHorizontal="16.0dip">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/toolbox"
                android:background="@drawable/afl_card_interface_nirwana"
                android:padding="16.0dip"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0"
                android:layout_marginEnd="8.0dip">
                <ImageView
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="30.0dip"
                    android:layout_height="30.0dip"
                    android:src="@drawable/afl_qs_interface" />
                <TextView
                    android:textSize="17.0sp"
                    android:textColor="?android:textColorPrimary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_width="fill_parent"
                    android:layout_height="49.0dip"
                    android:text="Quick Settings"
                    android:maxLines="2"
                    style="@style/afl_text_primary" />
            </LinearLayout>
            <LinearLayout
                android:gravity="start|center"
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0"
                android:layout_marginStart="8.0dip">
                <LinearLayout
                    android:gravity="start|center"
                    android:orientation="vertical"
                    android:id="@+id/dw_tile"
                    android:background="@drawable/afl_card_interface_nirwana"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginBottom="8.0dip"
                    android:layout_weight="1.0"
                    android:paddingStart="16.0dip"
                    android:paddingEnd="16.0dip">
                    <FrameLayout
                        android:padding="0.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent">
                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/lottie"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:scaleType="centerCrop"
                            android:alpha="0.8"
                            android:layout_alignParentStart="true"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/rattan" />
                        <TextView
                            android:textSize="18.0sp"
                            android:textColor="?android:textColorPrimary"
                            android:ellipsize="marquee"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Monet"
                            android:singleLine="true"
                            style="@style/afl_text_primary" />
                    </FrameLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="start|center"
                    android:orientation="vertical"
                    android:id="@+id/spoof"
                    android:background="@drawable/afl_card_interface_nirwana"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginTop="8.0dip"
                    android:layout_weight="1.0"
                    android:paddingStart="16.0dip"
                    android:paddingEnd="16.0dip">
                    <FrameLayout
                        android:padding="0.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent">
                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/lottie"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:scaleType="centerCrop"
                            android:alpha="0.5"
                            android:layout_alignParentStart="true"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/fallen" />
                        <TextView
                            android:textSize="18.0sp"
                            android:textColor="?android:textColorPrimary"
                            android:ellipsize="marquee"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Spoofing"
                            android:singleLine="true"
                            style="@style/afl_text_primary" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:background="@drawable/afl_card_interface_nirwana"
            android:layout_width="fill_parent"
            android:layout_height="115.0dip"
            android:layout_marginHorizontal="16.0dip">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/bottom_options"
                android:background="@drawable/afl_card_interface_nirwana"
                android:padding="20.0dip"
                android:layout_width="0.0dip"
                android:layout_height="100.0dip"
                android:layout_weight="1.0"
                android:layout_marginStart="8.0dip"
                android:layout_marginEnd="8.0dip"
                android:backgroundTint="@android:color/system_accent1_300">
                <ImageView
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    android:src="@drawable/afl_gesture_interface"
                    android:tint="#ff000000" />
                <TextView
                    android:textSize="11.0sp"
                    android:textColor="#ff000000"
                    android:ellipsize="marquee"
                    android:gravity="center"
                    android:layout_width="fill_parent"
                    android:layout_height="40.0dip"
                    android:text="Buttons"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    style="@style/afl_text_primary" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/statusbar"
                android:background="@drawable/afl_card_interface_nirwana"
                android:padding="16.0dip"
                android:layout_width="0.0dip"
                android:layout_height="100.0dip"
                android:layout_weight="1.0"
                android:layout_marginStart="8.0dip"
                android:backgroundTint="@android:color/system_accent1_300">
                <ImageView
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    android:src="@drawable/afl_misc_interface"
                    android:tint="#ff000000" />
                <TextView
                    android:textSize="11.0sp"
                    android:textColor="#ff000000"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_width="fill_parent"
                    android:layout_height="40.0dip"
                    android:text="Statusbar"
                    style="@style/afl_text_primary" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/aod_tile"
                android:background="@drawable/afl_card_interface_nirwana"
                android:padding="16.0dip"
                android:layout_width="0.0dip"
                android:layout_height="100.0dip"
                android:layout_weight="1.0"
                android:layout_marginStart="16.0dip"
                android:layout_marginEnd="8.0dip"
                android:backgroundTint="@android:color/system_accent1_300">
                <ImageView
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    android:src="@drawable/ic_ambient"
                    android:tint="#ff000000" />
                <TextView
                    android:textSize="11.0sp"
                    android:textColor="#ff000000"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_width="fill_parent"
                    android:layout_height="40.0dip"
                    android:text="Perf Mode"
                    style="@style/afl_text_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>